{
  "name": "@formsmith/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "build": "bun build src/index.ts src/worker.ts --target=bun --outdir=dist --external=postgres",
    "typecheck": "tsc --noEmit",
    "start": "bun dist/index.js",
    "worker": "bun dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@formsmith/core": "workspace:*",
    "elysia": "1.4.30",
    "@elysiajs/cors": "1.4.2",
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9",
    "better-auth": "1.7.6",
    "@better-auth/mcp": "1.7.6",
    "@better-auth/cimd": "1.7.6",
    "@modelcontextprotocol/server": "2.1.0",
    "@aws-sdk/client-s3": "3.1138.0",
    "@aws-sdk/s3-request-presigner": "3.1138.0",
    "zod": "4.6.5",
    "@better-auth/core": "1.7.6"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  },
  "license": "MIT"
}
