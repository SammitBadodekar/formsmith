{
  "name": "formsmith",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p .railway/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test packages apps/api/src apps/intake/src apps/selfhost/src apps/dashboard/tests",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate": "pnpm --filter @formsmith/api db:migrate",
    "db:generate": "pnpm --filter @formsmith/api db:generate",
    "dev:setup": "bun scripts/dev-setup.ts",
    "test:integration": "bun test apps/api/integration",
    "bench": "bun scripts/benchmark.ts",
    "recover:intake": "bun scripts/recover-intake.ts",
    "test:restore": "bun scripts/restore-smoke.ts",
    "test:selfhost": "pnpm --filter @formsmith/dashboard --filter @formsmith/forms build && bun scripts/selfhost-smoke.ts",
    "test:intake": "bun test packages/core/src/intake.test.ts apps/intake/src && bun scripts/intake-smoke.ts",
    "test:http": "bun scripts/e2e-http.ts",
    "test:gateway": "pnpm --filter @formsmith/dashboard --filter @formsmith/forms build && bun scripts/gateway-smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "railway": "3.11.0",
    "turbo": "2.11.3",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
