{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_API_URL", "VITE_FORMS_URL", "VITE_INTAKE_URL"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "PUBLIC_ORIGIN",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "BETTER_AUTH_SECRET",
        "INTAKE_URL",
        "CONTROL_KEYS",
        "ADMISSION_KEYS",
        "ACTIVE_KEY_ID",
        "ENCRYPTION_KEY",
        "CLOUDFLARE_ZONE_ID",
        "CLOUDFLARE_API_TOKEN",
        "CUSTOM_DOMAIN_TARGET"
      ]
    },
    "@formsmith/core#build": {
      "outputs": []
    },
    "@formsmith/editor#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@formsmith/renderer#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@formsmith/dashboard#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["worker-configuration.d.ts"]
    },
    "@formsmith/intake#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["worker-configuration.d.ts"]
    }
  }
}
